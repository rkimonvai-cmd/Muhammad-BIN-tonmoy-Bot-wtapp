# ==========================
# Branding and basic settings
# ==========================
BOT_NAME=𒁂 𝘼𝙇𝙄𝙔𝘼 𝘽𝘼𝘽𝙔__༊⫸
OWNER_NAME=𒁂【 𝘼𝘾𝙎 𝘾𝙔𝘽𝙀𝙍 𝙇𝙀𝘼𝘿𝙀𝙍 ☻ 𝙑𝘼𝙐 】𒁂⫸
BRANDING_NAME=ACS TONMOY

# Owner phone number in international format without + sign is recommended.
# Example: 8801XXXXXXXXX
OWNER_NUMBER=

# Comma-separated additional allowed users for BOT_MODE=private
ALLOWED_USERS=

PREFIX=.
BOT_LANG=en
BOT_MODE=public
TIMEZONE=Asia/Dhaka
SHOW_OWNER_NUMBER=true

# ==========================
# WhatsApp session
# ==========================
SESSION_CLIENT_ID=aliya-baby-bot
SESSION_DATA_PATH=./data/session
PUPPETEER_EXECUTABLE_PATH=

# ==========================
# Express / Render
# ==========================
PORT=3000
LOG_LEVEL=info

# ==========================
# Reconnect handling
# ==========================
AUTO_RECONNECT=true
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000

# ==========================
# Safety and command limits
# ==========================
MAX_MESSAGE_LENGTH=4096
COMMAND_RATE_LIMIT_MAX=12
COMMAND_RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ENTRIES=5000

# ==========================
# Optional group moderation
# Default is false.
# ==========================
AUTO_WELCOME=false
AUTO_GOODBYE=false
WELCOME_MESSAGE=
GOODBYE_MESSAGE=

ANTI_LINK=false
ANTI_LINK_ALLOWED_DOMAINS=
ANTI_LINK_EXEMPT_ADMINS=true
ANTI_LINK_WARN=true

ANTI_SPAM=false
ANTI_SPAM_WINDOW_MS=15000
ANTI_SPAM_MAX_MESSAGES=8
ANTI_SPAM_EXEMPT_ADMINS=true
ANTI_SPAM_WARN=true

# ==========================
# Optional AI reply
# OpenAI-compatible Chat Completions endpoint.
# ==========================
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_CHARS=1200
AI_MAX_OUTPUT_TOKENS=300
AI_TEMPERATURE=0.4
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_REPLY_IN_GROUPS=false
AI_SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Keep replies concise, safe, and polite. Do not reveal secrets.
